# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# written by examples/io.zn and cases_v2/io.zn
/conformance/iofix/dst.txt
/conformance/iofix/graph-live.txt

# Zown
# generated error packets
*.zerr
# generated manifests live next to source as <file>.zn.json — commit those you
# curate; ignore throwaway ones under tmp/
/tmp/

# Rust (commit Cargo.lock for the binary workspace; ignore build output)
/zownc/target/
**/target/
# rustc incremental cache if a link step is run from a crate directory
zownc/**/off/

# Generated WASM build artifacts. The runtime spliced into every module is source.
*.wat
*.wasm
!zownc/crates/zown-wasm/src/*.wat

# OS / editor
.DS_Store

# Local-only context scratchpad (chat transcripts the maintainer keeps to refresh
# an agent's context across sessions). Intentionally untracked.
PAST.md

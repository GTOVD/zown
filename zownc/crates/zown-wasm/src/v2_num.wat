          (then (call $fault (i32.const 11) (global.get $opcur)) (return)))
        (if (i32.and (f64.eq (local.get $fa) (f64.const 0)) (f64.lt (local.get $fe) (f64.const 0)))
          (then (call $fault (i32.const 2) (global.get $opcur)) (return)))
        (call $push_num (call $fpow (local.get $fa) (local.get $fe)))
        (return)))
    (if (i64.eq (local.get $bt) (i64.const 4))
      (then
        (if (i32.eqz (call $fits_i64 (i32.wrap_i64 (local.get $bp))))
          (then (call $fault (i32.const 1) (global.get $opcur)) (return)))
        (local.set $ev (call $big_to_i64 (i32.wrap_i64 (local.get $bp)))))
      (else (local.set $ev (local.get $bp))))
    (if (i64.lt_s (local.get $ev) (i64.const 0))
      (then
        (if (call $is_zero_val (local.get $at) (local.get $ap))
          (then (call $fault (i32.const 2) (global.get $opcur)) (return)))
        (call $push_num (call $fpow (call $num_f (local.get $at) (local.get $ap))
                                 (f64.convert_i64_s (local.get $ev))))
        (return)))
    (if (i32.or (i64.eq (local.get $at) (i64.const 4)) (i64.eq (local.get $bt) (i64.const 4)))
      (then (call $push_big (call $big_pow (call $promote (local.get $at) (local.get $ap)) (local.get $ev)))
            (return)))
    (if (i32.and (i64.gt_s (local.get $ev) (i64.const 63))
                 (i32.or (i64.ge_s (local.get $ap) (i64.const 2))
                         (i64.le_s (local.get $ap) (i64.const -2))))
      (then (call $fault (i32.const 1) (global.get $opcur)) (return)))
    (local.set $r (call $ipow (local.get $ap) (local.get $ev)))
    (if (global.get $err) (then return))
    (call $push (i64.const 0) (local.get $r)))

  (func $big_from_str (param $p i32) (result i32)
    (local $n i32) (local $i i32) (local $neg i32) (local $c i32) (local $start i32)
    (local.set $n (i32.load (local.get $p)))
    (block $ws (loop $wl
      (br_if $ws (i32.ge_s (local.get $i) (local.get $n)))
      (local.set $c (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i))))
      (br_if $ws (i32.eqz (call $is_ws (local.get $c))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $wl)))
    (local.set $c (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i))))
    (if (i32.eq (local.get $c) (i32.const 45))
      (then (local.set $neg (i32.const 1)) (local.set $i (i32.add (local.get $i) (i32.const 1)))))
    (if (i32.eq (local.get $c) (i32.const 43))
      (then (local.set $i (i32.add (local.get $i) (i32.const 1)))))
    (local.set $start (local.get $i))
    (if (i32.ge_s (local.get $i) (local.get $n))
      (then (call $fault (i32.const 8) (global.get $opcur)) (return (i32.const 0))))
    (block $ds (loop $dl
      (br_if $ds (i32.ge_s (local.get $i) (local.get $n)))
      (local.set $c (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i))))
      (if (i32.or (i32.lt_u (local.get $c) (i32.const 48)) (i32.gt_u (local.get $c) (i32.const 57)))
        (then (call $fault (i32.const 8) (global.get $opcur)) (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $dl)))
    (memory.copy (i32.const 640)
                 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $start))
                 (i32.sub (local.get $n) (local.get $start)))
    (call $mkbig (local.get $neg) (i32.const 640) (i32.sub (local.get $n) (local.get $start))))

  (func $do_big
    (local $at i64) (local $ap i64) (local $p i32)
    (call $pop) (local.set $ap) (local.set $at)
    (if (global.get $err) (then return))
    (if (i64.eq (local.get $at) (i64.const 4))
      (then (call $push (local.get $at) (local.get $ap)) (return)))
    (if (i64.eq (local.get $at) (i64.const 0))
      (then (call $push_big (call $big_i64 (local.get $ap))) (return)))
    (if (i64.eq (local.get $at) (i64.const 2))
      (then
        (local.set $p (call $big_from_str (i32.wrap_i64 (local.get $ap))))
        (if (global.get $err) (then return))
        (call $push_big (local.get $p))
        (return)))
    (if (i64.eq (local.get $at) (i64.const 1))
      (then
        (if (i32.eqz (call $f_whole (f64.reinterpret_i64 (local.get $ap))))
          (then (call $fault (i32.const 8) (global.get $opcur)) (return)))
        (if (i32.eqz (call $fits_f (f64.reinterpret_i64 (local.get $ap))))
          (then (call $fault (i32.const 1) (global.get $opcur)) (return)))
        (call $push_big (call $big_i64 (i64.trunc_f64_s (f64.reinterpret_i64 (local.get $ap)))))
        (return)))
    (call $fault (i32.const 8) (global.get $opcur)))

  (func $do_round (param $mode i32)
    (local $at i64) (local $ap i64) (local $v f64)
    (call $pop) (local.set $ap) (local.set $at)
    (if (global.get $err) (then return))
    (if (i32.or (i64.eq (local.get $at) (i64.const 0)) (i64.eq (local.get $at) (i64.const 4)))
      (then (call $push (local.get $at) (local.get $ap)) (return)))
    (if (i32.eqz (i64.eq (local.get $at) (i64.const 1)))
      (then (call $fault (i32.const 8) (global.get $opcur)) (return)))
    (local.set $v (f64.reinterpret_i64 (local.get $ap)))
    (if (f64.ne (local.get $v) (local.get $v))
      (then (call $fault (i32.const 11) (global.get $opcur)) (return)))
    (if (i32.or (f64.eq (local.get $v) (f64.const inf)) (f64.eq (local.get $v) (f64.const -inf)))
      (then (call $fault (i32.const 1) (global.get $opcur)) (return)))
    (if (i32.eq (local.get $mode) (i32.const 0))
      (then (local.set $v (f64.floor (local.get $v)))))
    (if (i32.eq (local.get $mode) (i32.const 1))
      (then (local.set $v (f64.ceil (local.get $v)))))
    (if (i32.eq (local.get $mode) (i32.const 2))
      (then (local.set $v (f64.nearest (local.get $v)))))
    (if (i32.eqz (call $fits_f (local.get $v)))
      (then (call $fault (i32.const 1) (global.get $opcur)) (return)))
    (call $push (i64.const 0) (i64.trunc_f64_s (local.get $v))))

  (func $do_rel (param $which i32)
    (local $at i64) (local $ap i64) (local $bt i64) (local $bp i64) (local $c i32)
    (call $pop) (local.set $bp) (local.set $bt)
    (if (global.get $err) (then return))
    (call $pop) (local.set $ap) (local.set $at)
    (if (global.get $err) (then return))
    (if (i32.and (i64.eq (local.get $at) (i64.const 0)) (i64.eq (local.get $bt) (i64.const 0)))
      (then
        (if (i32.eq (local.get $which) (i32.const 0))
          (then (local.set $c (i64.lt_s (local.get $ap) (local.get $bp)))))
        (if (i32.eq (local.get $which) (i32.const 1))
          (then (local.set $c (i64.gt_s (local.get $ap) (local.get $bp)))))
        (if (i32.eq (local.get $which) (i32.const 2))
          (then (local.set $c (i64.le_s (local.get $ap) (local.get $bp)))))
        (if (i32.eq (local.get $which) (i32.const 3))
          (then (local.set $c (i64.ge_s (local.get $ap) (local.get $bp))))))
      (else
        (if (i32.eq (local.get $which) (i32.const 0))
          (then (local.set $c (f64.lt (call $num_f (local.get $at) (local.get $ap))
                                      (call $num_f (local.get $bt) (local.get $bp))))))
        (if (i32.eq (local.get $which) (i32.const 1))
          (then (local.set $c (f64.gt (call $num_f (local.get $at) (local.get $ap))
                                      (call $num_f (local.get $bt) (local.get $bp))))))
        (if (i32.eq (local.get $which) (i32.const 2))
          (then (local.set $c (f64.le (call $num_f (local.get $at) (local.get $ap))
                                      (call $num_f (local.get $bt) (local.get $bp))))))
        (if (i32.eq (local.get $which) (i32.const 3))
          (then (local.set $c (f64.ge (call $num_f (local.get $at) (local.get $ap))
                                      (call $num_f (local.get $bt) (local.get $bp))))))))
    (call $push (i64.const 0) (i64.extend_i32_u (local.get $c))))

  (func $block_true (param $id i32) (result i32)
    (i32.gt_u (i32.load (call $rec_base (local.get $id))) (i32.const 0)))

  (func $do_hv
    (local $t i64) (local $p i64)
    (call $pop) (local.set $p) (local.set $t)
    (if (global.get $err) (then return))
    (if (i64.ne (local.get $t) (i64.const 5))
      (then (call $fault (i32.const 8) (global.get $opcur)) (return)))
    (call $push (i64.const 0) (i64.extend_i32_u (call $cap_has (i32.wrap_i64 (local.get $p))))))

  (func $do_rq
    (local $t i64) (local $p i64)
    (call $pop) (local.set $p) (local.set $t)
    (if (global.get $err) (then return))
    (if (i64.ne (local.get $t) (i64.const 5))
      (then (call $fault (i32.const 8) (global.get $opcur)) (return)))
    (if (i32.eqz (call $cap_has (i32.wrap_i64 (local.get $p))))
      (then (call $fault (i32.const 3) (i32.const 9)))))

  (func $take_width (result i64)
    (local $t i64) (local $p i64)
    (call $pop) (local.set $p) (local.set $t)
    (if (global.get $err) (then (return (i64.const 0))))
    (if (i64.ne (local.get $t) (i64.const 6))
      (then (call $fault (i32.const 8) (global.get $opcur)) (return (i64.const 0))))
    (local.get $p))

  (func $take_intish (result i64)
    (local $t i64) (local $p i64) (local $v f64)
    (call $pop) (local.set $p) (local.set $t)
    (if (global.get $err) (then (return (i64.const 0))))
    (if (i64.eq (local.get $t) (i64.const 0)) (then (return (local.get $p))))
    (if (i64.eq (local.get $t) (i64.const 4))
      (then
        (if (i32.eqz (call $fits_i64 (i32.wrap_i64 (local.get $p))))
          (then (call $fault (i32.const 1) (global.get $opcur)) (return (i64.const 0))))
        (return (call $big_to_i64 (i32.wrap_i64 (local.get $p))))))
    (if (i64.eq (local.get $t) (i64.const 1))
      (then
        (local.set $v (f64.reinterpret_i64 (local.get $p)))
        (if (i32.eqz (call $f_whole (local.get $v)))
          (then (call $fault (i32.const 8) (global.get $opcur)) (return (i64.const 0))))
        (if (i32.eqz (call $fits_f (local.get $v)))
          (then (call $fault (i32.const 1) (global.get $opcur)) (return (i64.const 0))))
        (return (i64.trunc_f64_s (local.get $v)))))
    (call $fault (i32.const 8) (global.get $opcur))
    (i64.const 0))

  (func $do_policy (param $which i32)
    (local $w i64) (local $n i64)
    (local.set $w (call $take_width))
    (if (global.get $err) (then return))
    (local.set $n (call $take_intish))
    (if (global.get $err) (then return))
    (if (i32.eq (local.get $which) (i32.const 0))
      (then (call $do_wr (local.get $n) (local.get $w))))
    (if (i32.eq (local.get $which) (i32.const 1))
      (then (call $do_st (local.get $n) (local.get $w))))
    (if (i32.eq (local.get $which) (i32.const 2))
      (then (call $do_ck (local.get $n) (local.get $w)))))
